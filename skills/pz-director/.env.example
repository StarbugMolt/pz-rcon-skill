# Project Zomboid / SIMON Discord-relay metadata
#
# Real deployment values live outside the repository. Keep authentication
# credentials out of this file; it contains routing IDs, enabled-mod metadata
# and non-secret runtime behavior only.

# Discord channel ID for PZ chat relay / SIMON player-facing broadcasts.
PZ_DISCORD_CHANNEL_ID=

# Discord channel ID for PZ server logs.
# SIMON observes deterministic lifecycle events here: player login, logout and
# death lines when the PZ server is configured to emit them. Log events update
# memory/greeting/arc state only; they do not directly trigger an LLM call.
PZ_DISCORD_LOG_CHANNEL_ID=

# Discord channel ID for PZ server-console relay.
# SIMON runtime uses scripts/pz-console.sh aliases rather than inventing raw
# PZ console syntax. The `raw` alias is an operator escape hatch only.
PZ_DISCORD_COMMANDS_CHANNEL_ID=

# Exact Discord user ID of the PZ server relay bot.
# Authoritative responses/log events are matched by ID, never by display name.
PZ_RELAY_BOT_ID=

# Enabled server Mod IDs. This deliberately mirrors the real PZ Mods= format
# supplied by the operator. Runtime parsers accept semicolon/backslash PZ form
# as well as the older comma-separated form.
PZ_ENABLED_MODS="\BreakBigRocks;\SKITTLE_LongTermPreservation4220;\ImmersiveReading;\RVTrailerTypeB42;\KI5trailers;\damnlib;\InjuredZombiesStumble;\LEGION18;\StarlitLibrary;\ProjectArcade;\HereGoesTheSun;\OCsPacking;\DeadMansDossier;\ResearchLabInternProfession;\70fordEscort;\95impreza;\96lancerEVO;\70roadRunner;\69charger;\82porsche911;\81deloreanDMC12;\CrowbarScrewdriverEntry;\CorvusNVG;\MoodleFramework;\DBFaster25;\Ladders42131;\DBNO_DownButNotOut;\SapphCooking_B42;\PROJECTRVInterior42;\BCR;\BCR-IAmNotYourMom;\DashRoamerB42;\87fordB700;\SkillJournal;\ZeroWeightKeys_B42;\Dry&Cure;\ProximityInventory;\ZEasyMove"

# Matching WorkshopItems= metadata, paired position-for-position with the
# 38 Mod IDs above. Kept for catalogue/audit coherence; these are not item IDs.
PZ_WORKSHOP_ITEMS="3538602374;3774789651;3606009875;3775310562;3330403100;3171167894;3648051123;3665548194;3378285185;3645980077;3618557184;3626823538;3675740871;3615135168;3670063857;3647735736;3647736504;3642935062;3631989559;3379334330;3253385114;3770164353;3769335201;3396446795;3393821407;3629835761;3774055538;3409143790;3543229299;3660382016;3745224257;3775809123;3110911330;3776641628;3776502124;3776848101;2847184718;3692079035"

# Raw console access is operator-only and disabled by default.
PZ_ALLOW_RAW=false

# SIMON supply behavior.
# Normal radio chat has NO reply cooldown. These settings control only actual
# item gifts made by the deterministic supply helper.
SIMON_GIFT_COOLDOWN_SECONDS=1800
SIMON_HELP_GIFT_CHANCE=0.20

# A survivor must explicitly report being outside/ready within this window
# before the guarded large-delivery helper may attempt a vehicle drop.
SIMON_OUTSIDE_READY_SECONDS=300

# Test mode is deliberately generous for validating the integration.
# When true, an explicit in-game request such as "Simon, give me some water"
# bypasses the gift cooldown and resolves a verified catalogue item whenever a
# safe match exists. The chat model is told to acknowledge the confirmed gift
# in character rather than refuse/complain about the generosity.
SIMON_TEST_MODE=false

# Confirmed console behavior.
# Waiting is the safe default because mutations must not be narrated as success
# without an authoritative relay response.
PZ_CONSOLE_WAIT=1
PZ_CONSOLE_TIMEOUT=8

# Shared lock used to serialize confirmed requests because the native PZ
# Discord bridge has no request/correlation ID.
PZ_CONSOLE_LOCK_FILE=/tmp/simon-pz-console.lock

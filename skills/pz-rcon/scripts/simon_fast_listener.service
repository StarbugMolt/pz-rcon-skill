[Unit]
Description=SIMON Fast Listener - Discord connection detector
After=network.target openclaw-gateway.service

[Service]
Type=simple
WorkingDirectory=/home/starbugmolt/.openclaw/workspace-simon/skills/pz-rcon
ExecStart=/usr/bin/python3 /home/starbugmolt/.openclaw/workspace-simon/skills/pz-rcon/scripts/simon_fast_listener.py
Restart=always
RestartSec=5
Environment=HOME=/home/starbugmolt
# Set PZ_DISCORD_CHANNEL_ID to YOUR pz-molt Discord channel id (do not commit a real id here)
Environment=PZ_DISCORD_CHANNEL_ID=YOUR_PZ_MOLT_CHANNEL_ID_HERE

[Install]
WantedBy=default.target
